# dependencies
node_modules/
**/node_modules/

# environment — NEVER commit secrets (.env holds Atlas creds, JWT secrets, passwords)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Cloud service-account keys. These arrive as a downloaded .json and land in the
# repo directory by accident — a plain `git add .` would commit a live signing
# key. They belong in .env (base64) and nowhere else.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccountKey*.json
gcp-*.json

# logs / coverage / build
logs/
*.log
**/logs/
coverage/
**/coverage/
dist/
**/dist/
.expo/

# owner's local planning notes — deliberately untracked


# OS / editor
.DS_Store

# Playwright MCP scratch output — screenshots, page snapshots and throwaway
# test scripts from browser verification. Not project source, and it has held a
# test-account password before: nothing in here belongs in a public repo.
.playwright-mcp/

# Claude Code's per-machine tool permissions — created by the local
# permission prompts, meaningless to anyone else and noisy in review.
# The shared config (.claude/settings.json, .claude/rules/) stays tracked.
.claude/settings.local.json
