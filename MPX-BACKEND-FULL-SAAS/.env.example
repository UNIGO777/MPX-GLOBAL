# MPX Global backend — environment variables.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Values are intentionally blank here. No secrets in this file.

# --- Core ---
# REQUIRED — one of: development | test | production. There is deliberately no
# default: a production deploy that forgets this used to run silently in
# development mode (Redis no longer required, rate limits fall back to in-memory,
# TRUST_PROXY unset). It now fails at boot instead.
NODE_ENV=
PORT=
# Public path the BROWSER uses for refresh/logout — what the refresh cookie is
# scoped to. Blank (= /auth) when the browser calls this API directly. Set to
# /api/auth when the web app reaches us through its own origin (Vercel rewrite);
# a cookie scoped to /auth would otherwise be stored and never sent.
REFRESH_COOKIE_PATH=

# Comma-separated browser origins allowed to call the API with credentials.
# Only needed for origins that call this API DIRECTLY — a proxied web app is
# server-to-server and sends no Origin. e.g. http://localhost:5173
CORS_ORIGINS=

# --- Database ---
MONGODB_URI=

# --- Auth: JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
# Refresh lifetime is REFRESH_TOKEN_TTL_DAYS (days, default 7) — set only to override.
REFRESH_TOKEN_TTL_DAYS=

# --- Auth: OTP (otplib) ---
OTP_SECRET=
OTP_STEP_SECONDS=
OTP_WINDOW=

# 🔴 Echo OTP codes to the terminal. LOCAL DEVELOPMENT ONLY — leave BLANK here
# and on every server. Needs BOTH this set to `true` AND NODE_ENV=development;
# either one missing means silence. Two locks on purpose: on 2026-08-07 the live
# API was found running without NODE_ENV=production, so a single gate would have
# been one missing variable away from writing real users' codes into production
# logs. Only value that enables it is the exact string `true`.
OTP_DEV_PRINT=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Per-document KYC upload cap in MB. ONE setting for BOTH portals — the multer
# limit, the storage-service check and the 'file too large' message all read it.
# The web client mirrors it for copy as VITE_KYC_MAX_FILE_MB; keep them equal.
KYC_MAX_FILE_MB=
# Shared store for rate limits (required in production).
REDIS_URL=
# Trusted proxy hops in front of the app (e.g. 1 behind nginx/ELB) — set in production.
TRUST_PROXY=

# --- Logging ---
LOG_LEVEL=

# --- Storage: Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI: OpenAI ---
OPENAI_API_KEY=
# Daily ceiling on AI searches by NOT-signed-in visitors, all of them combined
# (agreement 3.3 / 5.1). REQUIRED in production — the CLIENT chooses the number,
# since the OpenAI cost is on their account under 8.1. Over the ceiling, guests
# get ordinary keyword results instead of AI; signed-in users are unaffected.
# Resets at UTC midnight (= 05:30 IST).
AI_GUEST_DAILY_MAX=

# --- Payments: gateway with hold/release (escrow) ---
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
# HMAC secret used to verify inbound webhook signatures on the raw body (tracker C4).
PAYMENT_WEBHOOK_SECRET=

# --- OTP / notification delivery -------------------------------------------
# Fast2SMS — transactional SMS for OTP codes.
# 🔴 INDIA ONLY: Fast2SMS delivers to Indian (+91) mobile numbers. International
# buyers cannot receive an SMS code, so otp.sender.js falls back to EMAIL for any
# non-+91 number — which makes the SMTP block below load-bearing, not optional.
FAST2SMS_API_KEY=
# REQUIRED with the key. Template id for Fast2SMS's OTP API (`/dev/otp/send`) —
# that endpoint, not `bulkV2`. (bulkV2's DLT route answered "Invalid Sender ID":
# it also needs an approved sender id this account does not have.)
# Both vars must be set or the SMS transport reports itself unconfigured.
FAST2SMS_OTP_ID=
#
# ⚠️ Do NOT add FAST2SMS_OTP_LENGTH / FAST2SMS_OTP_EXPIRY. The endpoint takes
# `otp_length` and `otp_expiry`, but they are DERIVED from OTP_LENGTH and
# OTP_TTL_SECONDS so the SMS can never advertise an expiry the server ignores.
#
# ⚠️ Do NOT add FAST2SMS_OTP_LENGTH / FAST2SMS_OTP_EXPIRY (owner decision,
# 2026-08-04). OTP_LENGTH and OTP_TTL_SECONDS are the single source of truth for
# the A3 control (6 digits / 5 minutes) and the message text is rendered from
# them. A second knob would let the SMS claim an expiry the server ignores.

# SMTP — transactional email (OTP by email + the notification events un-deferred
# from D5 on 2026-08-04). Port 587 uses STARTTLS, so SMTP_SECURE=false; use
# SMTP_SECURE=true only with implicit TLS on port 465.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_LOGO_URL=
EMAIL_LOGO_WHITE_URL=

# --- Superadmin seed (npm run seed) — local only, never commit real values ---
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_MOBILE_CC=
SEED_SUPERADMIN_MOBILE_NUMBER=
SEED_SUPERADMIN_PASSWORD=
