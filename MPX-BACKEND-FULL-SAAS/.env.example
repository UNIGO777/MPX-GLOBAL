# MPX Global backend — environment variables.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Values are intentionally blank here. No secrets in this file.

# --- Core ---
NODE_ENV=
PORT=
# Comma-separated list of allowed web/mobile origins for CORS.
CORS_ORIGINS=

# --- Database ---
MONGODB_URI=

# --- Auth: JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
# Refresh lifetime is REFRESH_TOKEN_TTL_DAYS (days, default 7) — set only to override.
REFRESH_TOKEN_TTL_DAYS=

# --- Auth: OTP (otplib) ---
OTP_SECRET=
OTP_STEP_SECONDS=
OTP_WINDOW=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Per-document KYC upload cap in MB. ONE setting for BOTH portals — the multer
# limit, the storage-service check and the 'file too large' message all read it.
# The web client mirrors it for copy as VITE_KYC_MAX_FILE_MB; keep them equal.
KYC_MAX_FILE_MB=
# Shared store for rate limits (required in production).
REDIS_URL=
# Trusted proxy hops in front of the app (e.g. 1 behind nginx/ELB) — set in production.
TRUST_PROXY=

# --- Logging ---
LOG_LEVEL=

# --- Storage: Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI: OpenAI ---
OPENAI_API_KEY=

# --- Payments: gateway with hold/release (escrow) ---
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
# HMAC secret used to verify inbound webhook signatures on the raw body (tracker C4).
PAYMENT_WEBHOOK_SECRET=

# --- OTP / notification delivery -------------------------------------------
# Fast2SMS — transactional SMS for OTP codes.
# 🔴 INDIA ONLY: Fast2SMS delivers to Indian (+91) mobile numbers. International
# buyers cannot receive an SMS code, so otp.sender.js falls back to EMAIL for any
# non-+91 number — which makes the SMTP block below load-bearing, not optional.
FAST2SMS_API_KEY=
# ⚠️ CURRENTLY UNUSED — we send on Fast2SMS's `route=otp`, which uses their own
# approved OTP template and needs neither a template id nor a sender id.
# The DLT route was tried first and the live gateway answered "Invalid Sender ID"
# (2026-08-04): DLT additionally requires an approved FAST2SMS_SENDER_ID that this
# account does not have. Keep this value — it becomes relevant only if a DLT
# sender id is approved later.
# Consequence of the otp route: the SMS body is Fast2SMS's fixed wording, so the
# expiry cannot be put in the SMS. The email template still states it.
FAST2SMS_OTP_ID=
#
# ⚠️ Do NOT add FAST2SMS_OTP_LENGTH / FAST2SMS_OTP_EXPIRY (owner decision,
# 2026-08-04). OTP_LENGTH and OTP_TTL_SECONDS are the single source of truth for
# the A3 control (6 digits / 5 minutes) and the message text is rendered from
# them. A second knob would let the SMS claim an expiry the server ignores.

# SMTP — transactional email (OTP by email + the notification events un-deferred
# from D5 on 2026-08-04). Port 587 uses STARTTLS, so SMTP_SECURE=false; use
# SMTP_SECURE=true only with implicit TLS on port 465.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_LOGO_URL=
EMAIL_LOGO_WHITE_URL=

# --- Superadmin seed (npm run seed) — local only, never commit real values ---
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_MOBILE_CC=
SEED_SUPERADMIN_MOBILE_NUMBER=
SEED_SUPERADMIN_PASSWORD=
