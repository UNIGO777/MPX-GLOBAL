# Web frontend environment — VARIABLE NAMES ONLY, no real values.
# Copy to .env and fill in. Read by src/config.js (the one place the app reads
# env) and by vite.config.js (dev server + proxy).
#
# 🔴 ONLY VITE_-prefixed, genuinely PUBLIC values belong here — this bundle ships
# to the browser and anyone can read it. No key, token, password, OTP or
# connection string, ever (rules: web-frontend.md, secrets-and-hygiene.md).
# The OpenAI key and every other secret stay on the backend.
#
# Every key is optional: src/config.js falls back to the documented default.

# --- API -------------------------------------------------------------------
# Base path for API calls.
#   dev        → a same-origin path (/api), proxied by Vite to the backend
#   production → the absolute API origin, e.g.
#                VITE_API_BASE_URL=https://api.mpx.nxtgendigitals.com
# An absolute URL makes the browser call the API directly, so the server must
# allow this app's origin in CORS_ORIGINS and keep `credentials: true` — the
# httpOnly refresh cookie depends on it. Default: /api
VITE_API_BASE_URL=
# Request timeout in milliseconds. Default: 20000
VITE_API_TIMEOUT_MS=

# --- Dev server (vite.config.js only; not part of a production build) -------
# Where the dev proxy forwards API calls — the running backend.
# Default: http://localhost:3000
VITE_DEV_API_PROXY=
# Port for `npm run dev`. Default: 5173
VITE_DEV_PORT=

# --- Mirrors of server rules ------------------------------------------------
# ⚠️ The SERVER is authoritative for all of these and re-checks every one.
# These only drive what the user is TOLD. Keep them in step with the backend, or
# the UI will state a limit the API does not enforce.
# OTP lifetime in seconds (backend: 5 minutes). Default: 300
VITE_OTP_TTL_SECONDS=
# Resend cooldown in seconds. Default: 60
VITE_OTP_RESEND_COOLDOWN_SECONDS=
# KYC upload cap in megabytes (backend cap: 10). Default: 10
VITE_KYC_MAX_FILE_MB=
# File-picker accept list. Default: .pdf,.jpg,.jpeg,.png,.webp + their MIME types
VITE_KYC_ACCEPT=
# Rows-per-page choices, comma separated. The largest must not exceed the
# server's hard page-size cap. Default: 20,50,100
VITE_TABLE_PAGE_SIZES=

# --- Display formatting -----------------------------------------------------
# BCP-47 locale for dates. Default: en-GB
VITE_LOCALE_DATES=
# BCP-47 locale for thousands separators. Default: en-IN
VITE_LOCALE_NUMBERS=
