# Web frontend environment.
# ONLY VITE_-prefixed, genuinely PUBLIC values belong here — this bundle ships to the browser.
# No secrets, keys or tokens, ever (rules: web-frontend.md, secrets-and-hygiene.md).

# Base path for API calls. In dev, Vite proxies this to the backend (see vite.config.js).
VITE_API_BASE_URL=/api
